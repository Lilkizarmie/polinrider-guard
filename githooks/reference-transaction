#!/usr/bin/env bash
# scan-repo:self-exempt
# Fires on every ref update — fetch, pull, push, commit, reset.
# If an incoming ref would point a branch at a commit whose build config carries
# the RAT payload, abort the whole transaction so it never lands (not even as a
# remote-tracking pointer).
#
# FAIL OPEN: any internal error -> exit 0. The only exit 1 is a definite hit.
set +e
[ "${1:-}" = "prepared" ] || exit 0

MARK='_0x3d50aa|NONCE_FANOUT|BLOCK_MULTIPLE=0x3e8n|/0x/(cl|ls)|global\.i[[:space:]]*=[[:space:]]*.A8-'
CARRIERS='eslint.config.js eslint.config.mjs eslint.config.cjs babel.config.js
          postcss.config.js postcss.config.mjs postcss.config.cjs
          vite.config.js vite.config.ts tailwind.config.js
          next.config.js next.config.ts next.config.mjs metro.config.js'
ZERO='0000000000000000000000000000000000000000'

carrier_is_bad() {   # $1 = blob text
  printf '%s' "$1" | LC_ALL=C grep -qE "$MARK" && return 0          # payload marker
  printf '%s' "$1" | awk 'length>8000{b=1} END{exit(b?0:1)}' && return 0  # tab-wall line
  return 1
}

bad=''
while read -r old new ref; do
  [ "$old" = "$new" ] && continue
  case "$new" in ''|*[!0-9a-fA-F]*) continue ;; "$ZERO") continue ;; esac
  case "$ref" in refs/heads/*|refs/remotes/*) ;; *) continue ;; esac
  git cat-file -e "$new" 2>/dev/null || continue
  for f in $CARRIERS; do
    blob="$(git cat-file -p "$new:$f" 2>/dev/null | head -c 500000)"
    [ -z "$blob" ] && continue
    carrier_is_bad "$blob" && bad="$bad
    $ref  ->  $f"
  done
done

[ -z "$bad" ] && exit 0
{
  echo
  echo "  ✋ malware-guard: refusing this fetch/update — RAT-stager payload in:$bad"
  echo "     The remote branch is compromised. Nothing was written to your repo."
  echo
} >&2
exit 1
