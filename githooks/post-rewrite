#!/usr/bin/env bash
# After rebase / amend: warn loudly if the payload is in the working tree.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! "$DIR/scan-repo.sh" --worktree --block; then
  gd="$(git rev-parse --git-dir 2>/dev/null)"
  [ -n "$gd" ] && date > "$gd/MALWARE-DETECTED"
  echo "  ✋ malware-guard: RAT-stager payload in the working tree after a rewrite — do not build/lint." >&2
  exit 1
fi

. "$DIR/_chain.sh"; _chain post-rewrite "$@"
